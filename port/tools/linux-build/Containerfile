# The Linux release's build environment (port/tools/build_linux.sh --container): Debian 12
# "bookworm" (glibc 2.36, GCC 12, CMake 3.25), so the package runs on any distribution with
# glibc 2.36 or newer. Pinned by digest; SDL 3 and Dear ImGui come from the project's own
# CMake (FetchContent, pinned by SHA-256), built from source here.
#
# The -dev packages give SDL its display and sound backends (X11, Wayland, PipeWire,
# PulseAudio, ALSA, ...), which it loads at run time: the programs need none of them.
# libssl-dev / zlib1g-dev: static libcrypto.a / libssl.a / libz.a (Debian ships both the
# shared and static archives) for the Archipelago client (ss_ap_net), linked in statically
# so the package still needs only libc / libm / the loader (OPENSSL_USE_STATIC_LIBS /
# ZLIB_USE_STATIC_LIBS in port/tools/build_linux.sh).
FROM docker.io/library/debian@sha256:854dd8ab51d62866dbd8f5431d15ce77b12983a2a4a1e1fe43a2395dc7ef9f61

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates g++ cmake ninja-build pkg-config file binutils \
      libasound2-dev libpulse-dev libpipewire-0.3-dev \
      libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxfixes-dev libxi-dev libxss-dev libxtst-dev \
      libxkbcommon-dev libwayland-dev libwayland-bin wayland-protocols libdecor-0-dev \
      libdrm-dev libgbm-dev libgl-dev libgles-dev libegl-dev \
      libdbus-1-dev libibus-1.0-dev libudev-dev \
      libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
